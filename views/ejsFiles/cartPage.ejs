<% layout('/layouts/boilerplate.ejs') %>

<br>
<br>
<br>
<div class="container-fluid mt-4"> 
    <h1 class="mb-4 text-light fw-bold">🛒 Your Shopping Cart</h1>

    <% if (items.length === 0) { %>
        <div class="alert alert-secondary text-center text-dark fw-semibold shadow-sm p-4 rounded">
            Your cart is empty. <a href="/" class="fw-bold">Start shopping →</a>
        </div>
    <% } else { %>
        <div class="table-responsive shadow-lg rounded">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Price</th>
                        <th scope="col" class="text-center">Quantity</th>
                        <th scope="col">Subtotal</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <% if (item.product.image) { %>
                                        <img src="<%= item.product.image %>" alt="product" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                    <% } %>
                                    <div>
                                        <strong class="fs-6"><%= item.product.name %></strong><br>
                                        <small class="text-muted"><%= item.product.brand %></small>
                                    </div>
                                </div>
                            </td>
                            <td>₹<%= item.priceAtAddTime %></td>
                            <td class="text-center">
                                <form action="/cart/decrease/<%= item.product._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">−</button>
                                </form>
                                <span class="mx-2 fw-bold"><%= item.quantity %></span>
                                <form action="/cart/add/<%= item.product._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">+</button>
                                </form>
                            </td>
                            <td>₹<%= item.priceAtAddTime * item.quantity %></td>
                            <td class="text-center">
                                <form action="/cart/remove/<%= item.product._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="bg-dark text-light p-4 mt-4 mb-5 rounded shadow-sm d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Total: ₹<%= total %></h4>
            <a href="/checkout" class="btn btn-lg btn-success">Proceed to Checkout</a>
        </div>
    <% } %>
</div>
