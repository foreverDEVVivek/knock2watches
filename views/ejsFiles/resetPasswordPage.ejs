<% layout('/layouts/boilerplate') %>

<!-- Flash messages -->
<% if (success && success.length > 0) { %>
    <div class="alert alert-success">
        <h3><%= success %></h3>
    </div>
<% } %>

<% if (error && error.length > 0) { %>
    <div class="alert alert-danger">
        <h3><%= error %></h3>
    </div>
<% } %>

<div class="container d-grid align-items-center" style="min-height: 100vh;">
    <div class="container d-flex flex-column justify-content-center align-items-md-start" style="min-height: 10vh;">
        <div class="text-left"></div>
    </div>

    <div class="contact_section_2 container d-grid align-items-center" style="min-height: 100vh;">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-10">
                    <div class="mail_section_1">
                        <form method="POST" action="/users/reset-password/<%= token %>">
                            <h1 class="watchs_taital mb-6 w-100">05<br>Change Password</h1>

                            <input type="password" class="mail_text" placeholder="Password" required name="password">
                            <input type="password" class="mail_text" placeholder="Confirm Password" required name="confirmPassword">

                            <div class="w-100 mt-3 p-3 flex-box justify-content-between">
                                <div class="row g-3">
                                    <button class="send_bt w-100" type="submit">
        <a class="d-block w-100">Change Password</a>
      </button>
                                   <button class="send_bt w-100">
        <a class="d-block w-100"  href="/">Home</a>
      </button>
                                </div>
                            </div>
                        </form>
                    </div>              
                </div>
            </div>
        </div>
    </div>
</div>
